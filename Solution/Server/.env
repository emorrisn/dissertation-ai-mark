SECRET_KEY=super-secret-key
JWT_SECRET_KEY=super-jwt-secret
DATABASE_URL = 'postgresql://postgres:password@localhost:5432/marking_db'


# Converter Worker Settings
CONVERTER_WORKER_MODEL_PATH="nanonets/Nanonets-OCR2-3B"
CONVERTER_WORKER_MAX_NEW_TOKENS=1024
CONVERTER_WORKER_MAX_IMAGE_SIZE=1024
CONVERTER_WORKER_DTYPE="bfloat16"
CONVERTER_WORKER_DEVICE_MAP="auto"
CONVERTER_WORKER_ATTN_IMPLEMENTATION="sdpa"
CONVERTER_WORKER_LOAD_IN_4BIT="True"

# Evaluation Worker Settings
EVALUATION_WORKER_MODEL_PATH="meta-llama/Llama-3.2-3B-Instruct"
EVALUATION_WORKER_DTYPE="bfloat16"
EVALUATION_WORKER_DEVICE_MAP="auto"
EVALUATION_WORKER_ATTN_IMPLEMENTATION="sdpa"
EVALUATION_WORKER_LOAD_IN_4BIT="True"
EVALUATION_WORKER_TRUST_REMOTE_CODE="True"
EVALUATION_WORKER_LOW_CPU_MEM_USAGE="True"
EVALUATION_WORKER_DEBUG="True"

EVALUATION_WORKER_SUMMARY_TOKENS=250
EVALUATION_WORKER_CONFIDENCE_TOKENS=10
EVALUATION_WORKER_ITEM_TOKENS=250